{
  "name": "mermaid-markdown-editor",
  "version": "0.1.0",
  "description": "Modern Windows Mermaid + Markdown editor with export capabilities",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack:win-dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "highlight.js": "^11.11.1",
    "marked": "^14.1.2",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.mme.editor",
    "productName": "Mermaid Markdown Editor",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
